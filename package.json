{
  "name": "inmyin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:types": "supabase gen types typescript --linked > lib/supabase/database.types.ts",
    "app-icon": "node scripts/app-icon.mjs",
    "demo": "node scripts/demo/demo-data.mjs",
    "demo:posts": "node scripts/demo/render-posts.mjs",
    "test:demo": "node --test scripts/demo/demo-data.test.mjs scripts/demo/posts.test.mjs",
    "test:image": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/image/adjust.test.mjs lib/image/retouch.test.mjs lib/image/cutout-motion.test.mjs lib/image/photo-change.test.mjs",
    "test:template": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/inmyin/templates.test.mjs",
    "test:inventory": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/inventory/target.test.mjs lib/categories.test.mjs",
    "test:nav": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/nav/return-to.test.mjs",
    "test:history": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/history/layer.test.mjs",
    "test": "npm run test:demo && npm run test:image && npm run test:template && npm run test:inventory && npm run test:history && npm run test:nav"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@serwist/turbopack": "^9.5.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "konva": "^10.6.0",
    "next": "16.3.5",
    "onnxruntime-web": "^1.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "19.2.7",
    "serwist": "^9.5.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "license": "AGPL-3.0-only"
}

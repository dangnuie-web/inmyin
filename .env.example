# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
# 값은 Supabase 대시보드 › Project Settings › API Keys 에 있다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 서비스 키 (Supabase 대시보드 › Project Settings › API Keys › secret key).
# 푸시 알림을 받는 사람의 기기 목록을 읽을 때 쓴다. 화면 쪽 코드에서 쓰지 않는다
SUPABASE_SECRET_KEY=

# 웹 푸시(VAPID) 키. 만들기: npx web-push generate-vapid-keys
# 앞의 것은 브라우저에 보여도 되는 공개 키, 뒤의 것은 서버만 아는 비밀 키
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 있을 때 연락할 곳. mailto:메일주소
VAPID_SUBJECT=

# 유통기한 임박 알림 경로(/api/push/expiry)를 부를 때 쓰는 암호. 예약 실행(Vercel Cron)이 같은 값을 보낸다
CRON_SECRET=
